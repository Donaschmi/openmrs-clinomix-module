<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans-3.0.xsd">

    <!-- Shared FHIR R4 context — used as a library for parse/validate/serialize -->
    <bean id="clinom-x.FhirContext" class="ca.uhn.fhir.context.FhirContext"
          factory-method="forR4Cached"/>

    <!-- DAO -->
    <bean id="clinom-x.ClinomXDao"
          class="org.openmrs.module.clinomx.dao.impl.ClinomXDaoImpl">
        <property name="sessionFactory">
            <ref bean="sessionFactory"/>
        </property>
    </bean>

    <!-- ClinomX Service -->
    <bean id="clinom-x.ClinomXService"
          class="org.springframework.transaction.interceptor.TransactionProxyFactoryBean">
        <property name="transactionManager"><ref bean="transactionManager"/></property>
        <property name="target">
            <bean class="org.openmrs.module.clinomx.api.impl.ClinomXServiceImpl">
                <property name="dao"><ref bean="clinom-x.ClinomXDao"/></property>
            </bean>
        </property>
        <property name="preInterceptors"><ref bean="serviceInterceptors"/></property>
        <property name="transactionAttributeSource"><ref bean="transactionAttributeSource"/></property>
    </bean>

    <bean parent="serviceContext">
        <property name="moduleService">
            <list>
                <value>org.openmrs.module.clinomx.api.ClinomXService</value>
                <ref bean="clinom-x.ClinomXService"/>
            </list>
        </property>
    </bean>

    <!-- Questionnaire Service -->
    <bean id="clinom-x.FhirQuestionnaireService"
          class="org.springframework.transaction.interceptor.TransactionProxyFactoryBean">
        <property name="transactionManager"><ref bean="transactionManager"/></property>
        <property name="target">
            <bean class="org.openmrs.module.clinomx.api.impl.FhirQuestionnaireServiceImpl">
                <property name="fhirContext" ref="clinom-x.FhirContext"/>
                <property name="dao" ref="clinom-x.ClinomXDao"/>
            </bean>
        </property>
        <property name="preInterceptors"><ref bean="serviceInterceptors"/></property>
        <property name="transactionAttributeSource"><ref bean="transactionAttributeSource"/></property>
    </bean>

    <bean parent="serviceContext">
        <property name="moduleService">
            <list>
                <value>org.openmrs.module.clinomx.api.FhirQuestionnaireService</value>
                <ref bean="clinom-x.FhirQuestionnaireService"/>
            </list>
        </property>
    </bean>

    <!-- QuestionnaireResponse Service -->
    <bean id="clinom-x.FhirQuestionnaireResponseService"
          class="org.springframework.transaction.interceptor.TransactionProxyFactoryBean">
        <property name="transactionManager"><ref bean="transactionManager"/></property>
        <property name="target">
            <bean class="org.openmrs.module.clinomx.api.impl.FhirQuestionnaireResponseServiceImpl">
                <property name="fhirContext" ref="clinom-x.FhirContext"/>
                <property name="dao" ref="clinom-x.ClinomXDao"/>
            </bean>
        </property>
        <property name="preInterceptors"><ref bean="serviceInterceptors"/></property>
        <property name="transactionAttributeSource"><ref bean="transactionAttributeSource"/></property>
    </bean>

    <bean parent="serviceContext">
        <property name="moduleService">
            <list>
                <value>org.openmrs.module.clinomx.api.FhirQuestionnaireResponseService</value>
                <ref bean="clinom-x.FhirQuestionnaireResponseService"/>
            </list>
        </property>
    </bean>

</beans>
