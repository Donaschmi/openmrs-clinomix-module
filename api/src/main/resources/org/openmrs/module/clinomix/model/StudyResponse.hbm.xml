<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="org.openmrs.module.clinomix.model.StudyResponse" table="clinomix_study_response">

        <id name="id" type="int" column="id">
            <generator class="native"/>
        </id>

        <many-to-one name="study"
                     class="org.openmrs.module.clinomix.model.Study"
                     column="study_id"
                     not-null="true"/>

        <property name="questionnaireResponseFhirId"
                  column="questionnaire_response_fhir_id"
                  not-null="true"
                  length="255"/>

        <property name="dateAdded" column="date_added" not-null="true"/>

    </class>
</hibernate-mapping>
