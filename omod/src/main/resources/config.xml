<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module PUBLIC "-//OpenMRS//DTD OpenMRS Config 1.0//EN"
        "https://resources.openmrs.org/doctype/config-1.6.dtd">
<module configVersion="1.6">

    <!-- Base Module Properties -->
    <id>clinomix</id>
    <name>Clinomix</name>
    <version>1.0.0-SNAPSHOT</version>
    <package>org.openmrs.module.clinomix</package>
    <author>Clinomix Team</author>
    <description>
        Clinomix backend module for OpenMRS. Provides REST APIs and business logic
        for the Clinomix frontend application.
    </description>
    <activator>org.openmrs.module.clinomix.ClinomixActivator</activator>

    <!-- <updateURL>https://modules.openmrs.org/modules/download/@MODULE_ID@/update.rdf</updateURL> -->

    <!-- Required OpenMRS Version -->
    <require_version>2.6.* - 9.*</require_version>

    <!-- Required Modules -->
    <require_modules>
        <require_module version="2.30.0">org.openmrs.module.webservices.rest</require_module>
        <require_module version="2.2.0">org.openmrs.module.fhir2</require_module>
    </require_modules>

    <!-- Module Privileges -->
    <privilege>
        <name>Get Clinomix Data</name>
        <description>Ability to read Clinomix module data</description>
    </privilege>
    <privilege>
        <name>Manage Clinomix Data</name>
        <description>Ability to create, update, and delete Clinomix module data</description>
    </privilege>

    <!-- Global Properties -->
    <globalProperty>
        <property>clinomix.defaultLocale</property>
        <defaultValue>en</defaultValue>
        <description>Default locale for the Clinomix module</description>
    </globalProperty>
    <globalProperty>
        <property>clinomix.fhirServerUrl</property>
        <defaultValue>http://localhost:8082/fhir</defaultValue>
        <description>
            Base URL of the HAPI FHIR JPA server used by the Clinomix module.
            Example: http://localhost:8082/fhir
            Change this to point to a remote FHIR server if needed.
        </description>
    </globalProperty>

    <!-- Mapping files -->
    <mappingFiles>
        org/openmrs/module/clinomix/model/Study.hbm.xml
        org/openmrs/module/clinomix/model/StudyResponse.hbm.xml
    </mappingFiles>

    <!-- Internationalization -->
    <messages>
        <lang>en</lang>
        <file>messages.properties</file>
    </messages>

</module>
