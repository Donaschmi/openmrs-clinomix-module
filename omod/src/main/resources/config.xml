<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module PUBLIC "-//OpenMRS//DTD OpenMRS Config 1.0//EN"
        "https://resources.openmrs.org/doctype/config-1.6.dtd">
<module configVersion="1.6">

    <!-- Base Module Properties -->
    <id>clinom-x</id>
    <name>ClinomX</name>
    <version>1.0.0-SNAPSHOT</version>
    <package>org.openmrs.module.clinomx</package>
    <author>ClinomX Team</author>
    <description>
        ClinomX backend module for OpenMRS. Provides REST APIs and business logic
        for the ClinomX frontend application.
    </description>
    <activator>org.openmrs.module.clinomx.ClinomXActivator</activator>

    <!-- <updateURL>https://modules.openmrs.org/modules/download/@MODULE_ID@/update.rdf</updateURL> -->

    <!-- Required OpenMRS Version -->
    <require_version>2.6.* - 9.*</require_version>

    <!-- Required Modules -->
    <require_modules>
        <require_module version="2.30.0">org.openmrs.module.webservices.rest</require_module>
        <require_module version="2.2.0">org.openmrs.module.fhir2</require_module>
    </require_modules>

    <!-- Module Privileges -->
    <privilege>
        <name>Get ClinomX Data</name>
        <description>Ability to read ClinomX module data</description>
    </privilege>
    <privilege>
        <name>Manage ClinomX Data</name>
        <description>Ability to create, update, and delete ClinomX module data</description>
    </privilege>

    <!-- Global Properties -->
    <globalProperty>
        <property>clinom-x.defaultLocale</property>
        <defaultValue>en</defaultValue>
        <description>Default locale for the ClinomX module</description>
    </globalProperty>
    <globalProperty>
        <property>clinom-x.fhirServerUrl</property>
        <defaultValue>http://clinom-x-hapi-fhir:8080/fhir</defaultValue>
        <description>
            Base URL of the HAPI FHIR JPA server used by the ClinomX module.
            Example: http://localhost:8082/fhir
            Change this to point to a remote FHIR server if needed.
        </description>
    </globalProperty>

    <!-- Internationalization -->
    <messages>
        <lang>en</lang>
        <file>messages.properties</file>
    </messages>

</module>
